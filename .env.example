# Spotify application client ID. PKCE does not require a client secret.
SPOTIFY_CLIENT_ID=your-client-id

# Must match the redirect URI registered in your Spotify app.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional for LAN preview when the wrong network interface is detected:
# SPOTIFRAME_LAN_HOST=192.168.1.20

# If SPOTIFY_REDIRECT_URI is an HTTPS address, forward it through a TLS
# reverse proxy or tunnel to http://127.0.0.1:8888 on this machine.
# SPOTIFRAME_CALLBACK_PORT=8888
